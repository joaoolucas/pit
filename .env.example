# ---------------------------------------------------------------------------
# Pit — shared environment. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# --- Chain -----------------------------------------------------------------
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_EXPLORER_URL=https://testnet.monadexplorer.com

# --- Deployer / market maker ------------------------------------------------
# Hot key used by scripts/deploy + scripts/seed. Testnet only. Never reuse.
DEPLOYER_PRIVATE_KEY=

# --- Kuru (Monad testnet) ---------------------------------------------------
KURU_ROUTER=0x7EFbE105Ca7415dE98F96622173458ac1c054630
KURU_MARGIN_ACCOUNT=0xd029C2D98ff85D8F64799017fE00a59B1159CE02
KURU_UTILS=0xE0841E0F06c5770C1D4930EC6C507ee33199C88C

# --- Pit deployment (filled by `npm run deploy:testnet`) -------------------
PIT_FACTORY=
PIT_COLLATERAL=

# --- Envio HyperIndex -------------------------------------------------------
ENVIO_START_BLOCK=0
# Local dev: http://localhost:8080/v1/graphql
NEXT_PUBLIC_INDEXER_URL=http://localhost:8080/v1/graphql

# --- Web --------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadexplorer.com
NEXT_PUBLIC_PIT_FACTORY=
NEXT_PUBLIC_COLLATERAL=
# Relying-party id for the mera passkey (must equal the site host, no scheme/port)
NEXT_PUBLIC_PASSKEY_RP_ID=localhost

# --- Chainlink CRE ----------------------------------------------------------
CRE_ETH_PRIVATE_KEY=
CRE_PRICE_API=https://api.coinbase.com/v2/prices/BTC-USD/spot
