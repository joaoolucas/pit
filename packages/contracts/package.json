{
  "name": "@cell/contracts",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Cell issuance + settlement contracts, and the scripts that list every window on Kuru.",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network monadTestnet",
    "windows:roll": "hardhat run scripts/roll-windows.ts --network monadTestnet",
    "windows:roll:local": "hardhat run scripts/roll-windows.ts --network localhost",
    "seed": "hardhat run scripts/seed.ts --network monadTestnet",
    "seed:local": "hardhat run scripts/seed.ts --network localhost",
    "settle:manual": "hardhat run scripts/settle.ts --network monadTestnet",
    "export:abi": "hardhat run scripts/export-abi.ts",
    "settle:local": "hardhat run scripts/settle.ts --network localhost",
    "indexer:local": "hardhat run scripts/local-indexer.ts --network localhost",
    "demo:fills": "hardhat run scripts/demo-fills.ts --network monadTestnet",
    "demo:fills:local": "hardhat run scripts/demo-fills.ts --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.19",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.2.0"
  }
}
