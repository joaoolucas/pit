{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "allowImportingTsExtensions": true
  },
  "include": [
    "./scripts",
    "./test",
    "./hardhat.config.ts",
    "./typechain-types",
    "../core/src/**/*.ts",
    "../indexer/src/folds.ts",
    "../indexer/src/shared.ts",
    "../indexer/src/memory-store.ts"
  ]
}
