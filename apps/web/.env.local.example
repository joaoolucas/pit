# Web app configuration. Copy to .env.local and paste the addresses the deploy
# script prints.
#
# Monad testnet:
#   NEXT_PUBLIC_CHAIN_ID=10143
#   NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
#   NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadexplorer.com

NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EXPLORER_URL=http://127.0.0.1:8545

NEXT_PUBLIC_PIT_FACTORY=
NEXT_PUBLIC_COLLATERAL=

# Envio Cloud, `envio dev`, or scripts/local-indexer.ts — all speak the same shape.
NEXT_PUBLIC_INDEXER_URL=http://localhost:8080/v1/graphql

# The passkey's relying-party id: the site host, no scheme, no port.
NEXT_PUBLIC_PASSKEY_RP_ID=localhost
